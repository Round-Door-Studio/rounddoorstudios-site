{
  "name": "rounddoorstudios-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "test:local": "vitest run && playwright test",
    "test:all": "vitest run && playwright test --project=chromium --project=\"Mobile Safari\"",
    "seed": "tsx scripts/seed.ts",
    "seed:write": "tsx scripts/seed.ts --write"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1-beta-1782139553000",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.5.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.3",
    "jsdom": "^26.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
